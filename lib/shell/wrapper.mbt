///|
/// Fish shell wrapper generator
/// Creates wrapper functions that trace command execution and handle errors

///| Generate fish wrapper for a command
pub fn Command::to_fish_wrapper(self : Command) -> String {
  let name = self.name
  let lines : Array[String] = []

  // Function definition
  lines.push("# Wrapper for: " + name)
  if self.description.length() > 0 {
    lines.push("# " + self.description)
  }
  lines.push("function " + name + " --wraps=" + name)
  lines.push("    set -l __trace_id (random)")
  lines.push("    set -l __trace_start (date +%s%3N)")
  lines.push("    set -l __trace_cwd $PWD")
  lines.push("    set -l __trace_args $argv")
  lines.push("")

  // Pre-execution logging
  if self.tracing.enabled {
    lines.push("    # Trace: pre-execution")
    lines.push("    __shell_trace_start $__trace_id \"" + name + "\" $__trace_args")
    lines.push("")
  }

  // Execute command
  lines.push("    # Execute wrapped command")
  lines.push("    set -l __orig_cmd (command -s " + name + ")")
  lines.push("    set -l __stderr_file (mktemp)")
  lines.push("")
  lines.push("    if test -z \"$__orig_cmd\"")
  lines.push("        echo \"Command not found: " + name + "\" >$__stderr_file")
  lines.push("        cat $__stderr_file >&2")
  if self.tracing.enabled {
    lines.push("        set -l __trace_end (date +%s%3N)")
    lines.push("        set -l __duration (math $__trace_end - $__trace_start)")
    lines.push("        __shell_trace_end $__trace_id 127 $__duration $__stderr_file")
  }
  lines.push("        rm -f $__stderr_file")
  lines.push("        return 127")
  lines.push("    end")
  lines.push("")
  lines.push("    $__orig_cmd $argv 2>| tee $__stderr_file >&2")
  lines.push("    set -l __exit_code $pipestatus[1]")
  lines.push("")

  // Post-execution tracing
  if self.tracing.enabled {
    lines.push("    # Trace: post-execution")
    lines.push("    set -l __trace_end (date +%s%3N)")
    lines.push("    set -l __duration (math $__trace_end - $__trace_start)")
    lines.push("    __shell_trace_end $__trace_id $__exit_code $__duration $__stderr_file")
    lines.push("")
  }

  // Error handling
  if self.error_handlers.length() > 0 {
    lines.push("    # Error handling")
    lines.push("    if test $__exit_code -ne 0")
    lines.push("        set -l __stderr_content (cat $__stderr_file)")

    for handler in self.error_handlers {
      let pattern = handler.patterns.get(0).unwrap_or("")
      let action = match handler.action {
        Retry => "        # Retry logic"
        Agent(agent) => "        echo \"Suggestion: hive agent " + agent + " \\\"$__stderr_content\\\"\" >&2"
        Suggest(msg) => "        echo \"Suggestion: " + msg + "\" >&2"
        Fallback(cmd) => "        " + cmd
        Ignore => "        # Ignored"
        Abort(msg) => "        echo \"Error: " + msg + "\" >&2; return 1"
      }
      lines.push("        if string match -q '*" + pattern + "*' $__stderr_content")
      lines.push("            " + action)
      lines.push("        end")
    }
    lines.push("    end")
    lines.push("")
  }

  // Cleanup and return
  lines.push("    # Cleanup")
  lines.push("    rm -f $__stderr_file")
  lines.push("    return $__exit_code")
  lines.push("end")
  lines.push("")

  lines.join("\n")
}

///| Generate trace helper functions
pub fn generate_trace_helpers() -> String {
  let lines : Array[String] = []

  lines.push("# Shell tracing helpers")
  lines.push("# Generated by flow shell - do not edit manually")
  lines.push("")

  // Trace start function
  lines.push("function __shell_trace_start")
  lines.push("    set -l trace_id $argv[1]")
  lines.push("    set -l cmd $argv[2]")
  lines.push("    set -l args $argv[3..-1]")
  lines.push("    set -l timestamp (date +%s)")
  lines.push("    set -l trace_dir $__SHELL_TRACE_DIR")
  lines.push("    test -z \"$trace_dir\"; and set trace_dir /tmp/shell-traces")
  lines.push("    mkdir -p $trace_dir")
  lines.push("    echo \"{\\\"id\\\":\\\"$trace_id\\\",\\\"cmd\\\":\\\"$cmd\\\",\\\"args\\\":\\\"$args\\\",\\\"cwd\\\":\\\"$PWD\\\",\\\"start\\\":$timestamp}\" >> $trace_dir/traces.jsonl")
  lines.push("end")
  lines.push("")

  // Trace end function
  lines.push("function __shell_trace_end")
  lines.push("    set -l trace_id $argv[1]")
  lines.push("    set -l exit_code $argv[2]")
  lines.push("    set -l duration $argv[3]")
  lines.push("    set -l stderr_file $argv[4]")
  lines.push("    set -l timestamp (date +%s)")
  lines.push("    set -l trace_dir $__SHELL_TRACE_DIR")
  lines.push("    test -z \"$trace_dir\"; and set trace_dir /tmp/shell-traces")
  lines.push("    set -l stderr_content (cat $stderr_file 2>/dev/null | head -c 1000 | string escape)")
  lines.push("    echo \"{\\\"id\\\":\\\"$trace_id\\\",\\\"exit\\\":$exit_code,\\\"duration\\\":$duration,\\\"stderr\\\":\\\"$stderr_content\\\",\\\"end\\\":$timestamp}\" >> $trace_dir/traces.jsonl")
  lines.push("    ")
  lines.push("    # Update AI context")
  lines.push("    if test $exit_code -ne 0")
  lines.push("        __shell_update_context_error $trace_id $exit_code \"$stderr_content\"")
  lines.push("    end")
  lines.push("end")
  lines.push("")

  // Context update function
  lines.push("function __shell_update_context_error")
  lines.push("    set -l trace_id $argv[1]")
  lines.push("    set -l exit_code $argv[2]")
  lines.push("    set -l error $argv[3]")
  lines.push("    set -l context_file $__SHELL_CONTEXT_FILE")
  lines.push("    test -z \"$context_file\"; and set context_file /tmp/shell-context.json")
  lines.push("    # Append error to pending errors")
  lines.push("    echo \"{\\\"trace_id\\\":\\\"$trace_id\\\",\\\"error\\\":\\\"$error\\\"}\" >> $context_file.errors")
  lines.push("end")
  lines.push("")

  // Get context for AI
  lines.push("function __shell_get_context")
  lines.push("    set -l context_file $__SHELL_CONTEXT_FILE")
  lines.push("    test -z \"$context_file\"; and set context_file /tmp/shell-context.json")
  lines.push("    set -l trace_dir $__SHELL_TRACE_DIR")
  lines.push("    test -z \"$trace_dir\"; and set trace_dir /tmp/shell-traces")
  lines.push("    echo '{'")
  lines.push("    echo '  \"shell\": \"fish\",'")
  lines.push("    echo '  \"cwd\": \"'$PWD'\",'")
  lines.push("    echo '  \"user\": \"'$USER'\",'")
  lines.push("    echo '  \"recent_commands\": '")
  lines.push("    if test -f $trace_dir/traces.jsonl")
  lines.push("        echo '['")
  lines.push("        tail -n 10 $trace_dir/traces.jsonl | sed 's/$/,/' | sed '$ s/,$//'")
  lines.push("        echo ']'")
  lines.push("    else")
  lines.push("        echo '[]'")
  lines.push("    end")
  lines.push("    echo '}'")
  lines.push("end")
  lines.push("")

  lines.join("\n")
}

///| Generate full shell configuration script
pub fn ShellConfig::to_fish_script(self : ShellConfig) -> String {
  let lines : Array[String] = []

  lines.push("#!/usr/bin/env fish")
  lines.push("#")
  lines.push("# Shell Command Registry and Tracing")
  lines.push("# Version: " + self.version.to_string())
  lines.push("#")
  lines.push("# Generated by flow shell - do not edit manually")
  lines.push("#")
  lines.push("")

  // Environment setup
  lines.push("# Environment setup")
  lines.push("set -gx __SHELL_TRACE_DIR \"" + self.log_dir + "\"")
  lines.push("set -gx __SHELL_CONTEXT_FILE \"" + self.context_file + "\"")
  lines.push("set -gx __SHELL_AI_CONTEXT " + (if self.ai_context { "1" } else { "0" }))
  lines.push("")

  // Trace helpers
  lines.push(generate_trace_helpers())

  // Command wrappers
  lines.push("# Command wrappers")
  for cmd in self.commands {
    lines.push(cmd.to_fish_wrapper())
  }

  lines.push("# End of shell configuration")

  lines.join("\n")
}

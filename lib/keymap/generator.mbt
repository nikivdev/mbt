///|
/// Fish shell script generator for keymaps

///| Generate fish bind command for a single binding
pub fn KeyBinding::to_fish(self : KeyBinding) -> String {
  let mode_flag = if self.mode != Default {
    " -M " + self.mode.to_fish()
  } else {
    ""
  }

  let sets_mode_flag = match self.sets_mode {
    Some(m) => " -m " + m.to_fish()
    None => ""
  }

  let target = match self.action_type {
    Shell => escape_fish_string(self.target)
    Agent => "\"hive agent " + self.target + " \\\"$commandline\\\"\""
    Function => self.target
    Command => self.target
    Task => "\"f " + self.target + "\""
    Keymap => "\"set -g fish_bind_mode " + self.target + "; commandline -f repaint\""
  }

  let desc_comment = if self.description.length() > 0 {
    "  # " + self.description
  } else {
    ""
  }

  "bind" + mode_flag + sets_mode_flag + " " + self.keys + " " + target + desc_comment
}

///| Escape string for fish shell
fn escape_fish_string(s : String) -> String {
  // Simple escaping - wrap in quotes and escape internal quotes
  let escaped = s.replace(old="\\", new="\\\\").replace(old="\"", new="\\\"")
  "\"" + escaped + "\""
}

///| Generate complete fish script for a keymap
pub fn Keymap::to_fish_script(self : Keymap) -> String {
  let lines : Array[String] = []

  // Header comment
  lines.push("# Keymap: " + self.name)
  if self.description.length() > 0 {
    lines.push("# " + self.description)
  }
  lines.push("#")
  lines.push("# Generated by flow keymap - do not edit manually")
  lines.push("#")
  lines.push("")

  // Function wrapper for clean sourcing
  lines.push("function __keymap_" + sanitize_name(self.name))

  // Extends directive (comment for documentation)
  if self.extends.length() > 0 {
    lines.push("    # Extends: " + self.extends.join(", "))
    for base in self.extends {
      lines.push("    " + base)  // Call base keymap function
    }
    lines.push("")
  }

  // Generate bindings grouped by mode
  let by_mode = group_by_mode(self.bindings)

  for entry in by_mode {
    let (mode, bindings) = entry
    if mode != "default" {
      lines.push("    # Mode: " + mode)
    }
    for binding in bindings {
      lines.push("    " + binding.to_fish())
    }
    lines.push("")
  }

  lines.push("end")
  lines.push("")

  // Auto-call if this is the active keymap
  lines.push("# Activate keymap")
  lines.push("__keymap_" + sanitize_name(self.name))

  lines.join("\n")
}

///| Group bindings by mode
fn group_by_mode(bindings : Array[KeyBinding]) -> Map[String, Array[KeyBinding]] {
  let result : Map[String, Array[KeyBinding]] = {}

  for binding in bindings {
    let mode = binding.mode.to_fish()
    match result.get(mode) {
      Some(arr) => arr.push(binding)
      None => result.set(mode, [binding])
    }
  }

  result
}

///| Sanitize name for fish function naming
fn sanitize_name(name : String) -> String {
  let chars : Array[Char] = []
  for c in name {
    if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
      chars.push(c)
    } else {
      chars.push('_')
    }
  }
  String::from_array(chars)
}

///| Generate complete fish config from KeymapConfig
pub fn KeymapConfig::to_fish_script(self : KeymapConfig) -> String {
  let lines : Array[String] = []

  lines.push("#!/usr/bin/env fish")
  lines.push("#")
  lines.push("# Flow Keymap Configuration")
  lines.push("# Version: " + self.version.to_string())
  lines.push("# Active: " + self.active)
  lines.push("#")
  lines.push("# Source this file in your config.fish:")
  lines.push("#   source ~/.config/fish/conf.d/flow-keymaps.fish")
  lines.push("#")
  lines.push("")

  // Generate each keymap
  for keymap in self.keymaps {
    if keymap.enabled {
      lines.push(keymap.to_fish_script())
      lines.push("")
    }
  }

  // Set active keymap
  lines.push("# Set active keymap")
  lines.push("set -g __flow_active_keymap " + self.active)

  lines.join("\n")
}

///| Create default enhanced keymap
pub fn default_keymap() -> Keymap {
  Keymap::{
    name: "default-enhanced",
    description: "Enhanced default keybindings with agent shortcuts",
    extends: ["fish_default_key_bindings"],
    enabled: true,
    tags: ["default", "productivity"],
    bindings: [
      // Agent shortcuts
      KeyBinding::new("ctrl-alt-g", Agent, "git")
        .with_description("Git operations agent"),
      KeyBinding::new("ctrl-alt-f", Agent, "find")
        .with_description("File search agent"),
      KeyBinding::new("ctrl-alt-h", Agent, "help")
        .with_description("Help agent"),

      // Task shortcuts
      KeyBinding::new("ctrl-alt-c", Task, "clean-scan")
        .with_description("Scan for repo cruft"),
      KeyBinding::new("ctrl-alt-b", Task, "build")
        .with_description("Build project"),
      KeyBinding::new("ctrl-alt-t", Task, "test")
        .with_description("Run tests"),

      // Shell shortcuts
      KeyBinding::new("ctrl-x ctrl-e", Shell, "$EDITOR (commandline)")
        .with_description("Edit command in editor"),
      KeyBinding::new("ctrl-x ctrl-r", Shell, "source ~/.config/fish/config.fish")
        .with_description("Reload fish config"),

      // Navigation
      KeyBinding::new("alt-up", Function, "cd ..")
        .with_description("Go up one directory"),
      KeyBinding::new("alt-left", Function, "prevd")
        .with_description("Previous directory"),
      KeyBinding::new("alt-right", Function, "nextd")
        .with_description("Next directory"),
    ],
  }
}

///| Create vi-mode keymap
pub fn vi_keymap() -> Keymap {
  Keymap::{
    name: "vi-enhanced",
    description: "Vi-style keybindings with agent integration",
    extends: ["fish_vi_key_bindings"],
    enabled: true,
    tags: ["vi", "modal"],
    bindings: [
      // Normal mode agent shortcuts
      KeyBinding::new("g a", Agent, "git")
        .with_mode(Normal)
        .with_description("Git agent"),
      KeyBinding::new("g f", Agent, "find")
        .with_mode(Normal)
        .with_description("Find agent"),
      KeyBinding::new("g h", Agent, "help")
        .with_mode(Normal)
        .with_description("Help agent"),

      // Leader key style
      KeyBinding::new("space t", Task, "test")
        .with_mode(Normal)
        .with_description("Run tests"),
      KeyBinding::new("space b", Task, "build")
        .with_mode(Normal)
        .with_description("Build project"),
      KeyBinding::new("space c", Task, "clean-scan")
        .with_mode(Normal)
        .with_description("Clean scan"),
    ],
  }
}
